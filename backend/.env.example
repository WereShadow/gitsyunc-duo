# GitSync Duo Configuration
PROJECT_NAME="GitSync Duo"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL URL in production, SQLite local default for easy dev)
DATABASE_URL="sqlite+aiosqlite:///./gitsync.db"
# Example PostgreSQL for production:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/gitsync_duo"

# Security
SECRET_KEY="gitsync-super-secret-jwt-key-for-development-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Token encryption key for GitHub access tokens (Fernet url-safe base64 32-byte key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY="dGVzdC1mZXJuZXQta2V5LWZvci1naXRzeW5jLWR1by1kZXYxMjM="

# GitHub OAuth & Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET="gitsync_webhook_secret_dev_2026"

# Duo Defaults
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_DEADLINE="23:59"
DEFAULT_GRACE_PERIOD_MINUTES=30

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
